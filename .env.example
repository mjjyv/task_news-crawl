# Database Configuration (Defaults to SQLite for local development)
DATABASE_URL=sqlite:///news.db
# For PostgreSQL (Docker/Production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vnexpress_news

# Redis Configuration (For Deduplication Set)
REDIS_URL=redis://localhost:6379/0

# Crawler Configuration
BASE_URL=https://vnexpress.net
RSS_BASE_URL=https://vnexpress.net/rss
DOWNLOAD_DELAY_MIN=0.5
DOWNLOAD_DELAY_MAX=1.0
REQUEST_TIMEOUT=15.0
MAX_RETRIES=3
CONCURRENT_REQUESTS=5

# Media Configuration
SAVE_MEDIA_LOCAL=false
MEDIA_STORAGE_DIR=./data/media
